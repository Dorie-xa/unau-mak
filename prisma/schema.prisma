generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  OPEN
  COMING_SOON
  CLOSED
}

enum FieldType {
  TEXT
  EMAIL
  TEXTAREA
  SELECT
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model Member {
  id            String                 @id @default(cuid())
  fullName      String
  studentNumber String?
  email         String                 @unique
  programme     String?
  yearOfStudy   String?
  passwordHash  String
  sdgs          Int[]                  @default([])
  createdAt     DateTime               @default(now())
  registrations ProjectRegistration[]
}

model HomeCard {
  id          String   @id @default(cuid())
  icon        String?
  imageUrl    String?
  title       String
  description String
  position    Int      @default(0)
  createdAt   DateTime @default(now())
}

model FooterLink {
  id       String @id @default(cuid())
  label    String
  value    String
  icon     String?
  position Int    @default(0)
}

model ChapterSettings {
  id             String @id @default(cuid())
  welcomeMessage String
}

model Project {
  id            String                 @id @default(cuid())
  slug          String                 @unique
  name          String
  description   String
  status        ProjectStatus          @default(COMING_SOON)
  bannerUrl     String?
  infoLinks     Json?
  createdAt     DateTime               @default(now())
  fields        RegistrationField[]
  registrations ProjectRegistration[]
}

model RegistrationField {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label     String
  type      FieldType @default(TEXT)
  required  Boolean   @default(true)
  options   String[]  @default([])
  position  Int       @default(0)
}

model ProjectRegistration {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  memberId  String?
  member    Member?  @relation(fields: [memberId], references: [id])
  data      Json
  createdAt DateTime @default(now())
}
